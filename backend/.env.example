HOST=0.0.0.0
PORT=3001
# File SQLite tersimpan pada backend/data secara default.
# DATA_FILE=C:/path/eco-herd.sqlite

# AI berjalan di laptop lewat Python backend/.venv (bukan di ESP32).
AI_MODEL_DIR=C:/Eco-Herd
# Default 1; nilai 0 mematikan worker AI.
AI_ENABLED=1
# Opsional jika memakai virtualenv lain. Gunakan path executable tanpa argumen.
# AI_PYTHON=C:/path/to/python.exe
